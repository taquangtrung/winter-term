      "escape": "\u001b]9001;emit;v=1,id=3,trust=trusted;eyJtZXRhIjp7ImhlaWdodF9oaW50Ijo0LCJ0aXRsZSI6IlJlcG9ydCJ9LCJtaW1lIjp7InRleHQvaHRtbCI6IjxiPmhpPC9iPiIsInRleHQvcGxhaW4iOiJoaSJ9fQ==\u001b\\"
