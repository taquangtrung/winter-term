# Maintainer: Quang Trung Ta <taquangtrungvn@gmail.com>
#
# Builds from the release tarball rather than a -bin package: Arch users
# expect a source build, and the dependency set below is exactly what the
# Linux CI job installs, so a break here shows up in CI first.
#
# Publishing checklist:
#   1. Update pkgver, and set pkgrel back to 1.
#   2. updpkgsums                    # rewrites sha256sums from the tarball
#   3. makepkg --printsrcinfo > .SRCINFO
#   4. Commit PKGBUILD and .SRCINFO to the AUR repo.

pkgname=winter-term
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal-first IDE with GPU rendering, Vim editing, and editors as tabs"
arch=('x86_64' 'aarch64')
url="https://github.com/taquangtrung/winter-term"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'pkgconf')
provides=('winter')
conflicts=('winter')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    # Vendor up front so build() runs with --offline, which is what makepkg
    # expects and what makes the build reproducible.
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
    # The bundled extensions are built for WebAssembly: rustup adds the
    # target; without rustup, Arch's rust-wasm package carries it.
    if command -v rustup >/dev/null; then rustup target add wasm32-wasip2; fi
    cargo fetch --locked --target wasm32-wasip2
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p winter-term
    # The extensions Winter ships, built as WebAssembly components.
    cargo rustc --frozen -p winter-copilot --features wasm --release \
        --target wasm32-wasip2 --crate-type cdylib
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    # Headless: the suite covers the parser, grid, config, and mux, none of
    # which need a display.
    cargo test --frozen --workspace
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/winter" "$pkgdir/usr/bin/winter"
    install -Dm644 "packaging/linux/winter-terminal.desktop" \
        "$pkgdir/usr/share/applications/winter-terminal.desktop"
    install -Dm644 "crates/app/winter-term/assets/icons/winter-terminal.png" \
        "$pkgdir/usr/share/pixmaps/winter-terminal.png"
    install -Dm644 "crates/app/winter-term/assets/icons/winter-terminal-64.png" \
        "$pkgdir/usr/share/icons/hicolor/64x64/apps/winter-terminal.png"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "target/wasm32-wasip2/release/winter_copilot.wasm" \
        "$pkgdir/usr/lib/winter/extensions/copilot/copilot.wasm"

    for shell in bash zsh fish; do
        install -Dm644 "clients/shell-integration/winter.$shell" \
            "$pkgdir/usr/share/winter-term/shell-integration/winter.$shell"
    done
    install -Dm644 "crates/app/winter-term/builtin/settings.kdl" \
        "$pkgdir/usr/share/doc/$pkgname/examples/settings.kdl"
    install -Dm644 "crates/base/winter-model/builtin/keybindings.kdl" \
        "$pkgdir/usr/share/doc/$pkgname/examples/keybindings.kdl"
}
