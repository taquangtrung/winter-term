// Winter's built-in light theme: the dark theme's palette on a light
// surface, its source colors darkened until they read there, and no git
// colors (the git views derive theirs from the palette). Winter reads its
// light preset from this file. The window chrome is derived from the
// background and foreground, so it has no colors here.
//
// Every color must be named: one left out is black. A theme file of your
// own in `themes/` can start from this one with `base "light"`.

colors {
    background "#f2f2f2"
    active-indicator "#1a75e8"
    active-pane-border "#9c4f14"
    foreground "#1e1e1e"
    cursor-bg "#262626"
    cursor-fg "#ffffff"
    find-label-bg "#a8d5ff"
    find-label-fg "#0b4fa8"
    scrollbar "#135581"
    search-current-bg "#275bad"
    search-match-bg "#e6b422"
    selection-bg "#2257a0"
    selection-fg "#000000"
    split "#cccccc"
    status-bar-border "#3a3f45"
    status-bar-fg "#15181a"
    tab-strip "#dfdfdf"
    line-number-active "#7d7d7d"
    visual-bell "#c85010"
    window-border "#414248"
    syntax {
