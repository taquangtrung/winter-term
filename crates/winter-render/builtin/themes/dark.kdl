// Winter's built-in dark theme: magic-vscode's One Color theme, from its
// editor and terminal colors. Winter reads its dark preset from this file.
// The window chrome (title bar, tabs, menus, the cursor's row) is derived
// from the background and foreground, so it has no colors here.
//
// Every color must be named: one left out is black. A theme file of your
// own in `themes/` can start from this one with `base "dark"`.

colors {
    background "#262a32"
    active-indicator "#1a75e8"
    active-pane-border "#b8641e"
    foreground "#bbc2cf"
    cursor-bg "#51afef"
    cursor-fg "#000000"
    find-label-bg "#a8d5ff"
    find-label-fg "#0b4fa8"
    scrollbar "#135581"
    search-current-bg "#275bad"
    search-match-bg "#e6b422"
    selection-bg "#2257a0"
    selection-fg "#000000"
    split "#51554f"
    status-bar-border "#3a3f45"
    status-bar-fg "#15181a"
    tab-strip "#21242a"
    line-number-active "#787e88"
    visual-bell "#e08020"
    window-border "#414248"
    git {
        added "#91af22"
        deleted "#da5f59"
        inserted-text "#215714df"
        inserted-line "#23372dfb"
        modified "#8fb1f5"
        renamed "#d1b32f"
        unmerged "#a75abe"
        file-conflict "#f14c4c"
