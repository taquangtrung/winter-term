// Winter's built-in settings: Winter reads its defaults from this file, and
// lays your ~/.config/winter-term/settings.kdl over it. A setting your file
// leaves out, or gives a value Winter cannot use, keeps the value here.
//
// Every option is shown. One commented out has no value by default, and its
// comment says what having none means.
//
// Keybindings live in a separate file: ~/.config/winter-term/keybindings.kdl
// User themes live in: ~/.config/winter-term/themes/<name>.kdl

// ── Theme ─────────────────────────────────────────────────────────────────────
// Built-in values: "dark", "light", "auto" (follows system appearance).
// Custom: the filename (without .kdl) of a file in ~/.config/winter-term/themes/.
theme "dark"

// ── Terminal ──────────────────────────────────────────────────────────────────
// Shell executable. Defaults to the SHELL environment variable.
// shell "/bin/zsh"

// Per-platform override, which wins over `shell` on that OS. Useful for one
// config file shared across machines.
// shell-linux "/bin/zsh"
// shell-macos "/opt/homebrew/bin/fish"
// shell-windows "pwsh.exe"

// Maximum scrollback lines per pane. Applied to new panes (default: 10000).
// scrollback-lines 10000

// ── Font ──────────────────────────────────────────────────────────────────────
// Font family. Falls back to the system monospace font when not set.
// font "FiraCode Nerd Font"

// Point size.
font-size 15

// Named font weight for normal text ("thin", "light", "regular", "medium",
// "semibold", "bold", "extrabold", "black", or a numeric value like "400").
// Falls back to the font's default when not set.
// font-weight "regular"

// Named weight for bold text. Falls back to font-weight when not set.
// font-weight-bold "bold"

// Enable OpenType ligatures (e.g. -> and => rendered as arrows). Default: false:
// like most terminals, winter keeps every glyph at its nominal cell position, so
// contextual shaping never shifts a character out of the monospace grid.
ligatures #false

// ── Window ────────────────────────────────────────────────────────────────────
// Background opacity. 1.0 is fully opaque; lower values require a compositor.
opacity 1

// Title bar presentation.
//   "modern": borderless: the tab strip doubles as the title bar with custom
//              minimize/maximize/close controls.
//   "system": native OS window decorations; the tab strip sits inside them.
title-bar-style "modern"

// Which edge of the title bar carries the window controls.
//   "left": controls on the left (default, macOS-style).
//   "right": controls on the right (Windows-style).
window-controls-side "left"

// Which edge of a listing's rows the gutter stands at: the narrow column of
// git states and marks the file browser draws.
//   "left": at the left edge, ahead of the names (default).
//   "right": at the right edge.
gutter-side "left"

// Where the text editor starts the rows a long line wraps onto.
//   "none": at the gutter.
//   "same": under the line's first character, past its indentation.
//   "semantic": under the line's text, past what opens it: a list item's
//   bullet, a heading's #s, a quote's >, a comment's marker, an \item
//   (default).
editor-wrap-indent "semantic"

// How many screen rows an editor (text, Dir, Git, Grep, ...) keeps above and
// below the cursor as the view scrolls after it, like Vim's scrolloff: zt and
// zb leave that many, and H and L stop that far in. Held under half the
// pane; 0 turns it off (default: 5).
scroll-margin 5

// When the text editor hides markup's markers, as magic-vscode does: the
// ** of **bold**, the _ of _italic_, the backticks of `code`, the $ of
// $math$, a heading's #s, and a link's [ and ](url) in Markdown; \textbf{
// and its } (and \emph, \textit, \texttt, {\bf ..}, ...) in LaTeX; and the
// like in Org, reStructuredText, AsciiDoc, Typst, and the /// and /** */
// doc comments of code. The text they mark is drawn bold, italic,
// underlined (a link's text, <u>, \underline), or struck (~~, \sout).
//   "visible": never.
//   "show-on-cursor": except in a span the cursor or the selection
//   touches, and a heading's on the cursor's line.
//   "always-hidden": always (default).
editor-markup-markers "always-hidden"

// Menu presentation in the tab strip.
//   "modern": a single ☰ hamburger button opens a command dropdown.
//   "classic": a File / Edit / View / Window menubar row above the tab strip.
menu-style "modern"

// Window title. `{{ ... }}` placeholders expand to what the active tab shows;
// everything else is literal text. A part a placeholder leaves empty drops out
// with its ` - `.
//   {{ name }}       what the tab shows: the file, the directory, the program
//   {{ location }}   the directory it is in, home written ~
//   {{ path }}       the whole place: the location and the name together
//   {{ title }}      what the tab strip shows for the active tab
//   {{ app_name }}   the foreground program's name
//   {{ pane_title }} the title the program set for itself
//   {{ cwd }}        the pane's working directory, abbreviated
// For the app first, as "Winter Term: ~/src/main.rs": "Winter Term: {{ path }}".
window-title-template "{{ name }} — Winter Term"

// Underline fuzzy-matched characters in the command palette results list.
palette-match-underline #false

// Thickness of the line drawn between adjacent split panes, in logical pixels.
pane-border-width 1

// How tall the field you type into is in every popup (the command palette and
// every picker, the find box, a question), in rows of the terminal's font:
// from 1 (a line of text, nothing round it) to 4.
popup-input-height 1.5

// Right-click pastes from the clipboard instead of opening the context menu.
paste-on-right-click #false

// Underline auto-detected and OSC 8 hyperlink URLs. Default: false.
url-underline #false

// Restore the previous tab/pane layout on launch. Default: false.
restore-session #false

// ── Reading aids ──────────────────────────────────────────────────────────
// Color brackets by nesting depth, so a deep expression reads at a glance.
rainbow-parens #false

// Band alternating sentences, as a reading aid over long paragraphs of output.
sentence-highlight #false

// Hang the continuation of a soft-wrapped line under where the line started,
// instead of at column zero. Like wrap-words, applied to the scrollback when a
// width change settles. Default: true.
wrap-indent #true

// Break soft wraps at word boundaries (the partial word after the last space on
// a full row moves down with the wrap) instead of exactly at the margin
// mid-word. Applied to the scrollback when a pane's width change settles: the
// visible screen always wraps at the margin, because programs redraw it
// assuming that. Default: true.
wrap-words #true

// ── Cursor ────────────────────────────────────────────────────────────────────
// Per-mode cursor shapes: "block", "bar" (vertical beam), or "underline".
cursor {
    // Blink the cursor in the focused pane. Default: true.
    blink #true
    insert "bar"
    normal "block"
    visual "block"

    // Inactive (non-focused) panes show their cursor as a hollow outline, so
    // you can see where each one stands; set this to hide it there entirely.
    // Default: false.
    hide-in-inactive #false
}

// Dim inactive panes by blending their colors toward the background. Default: false.
dim-inactive #false

// ── Status bar ────────────────────────────────────────────────────────────────
status-bar {
    // Show or hide the entire status bar (freeing its reserved row when hidden).
    // Default: shown.
    show #true

    // Show the current mode label (N / I / V / B).
    // Default: shown (#true).
    show-mode #true

    // What the right side shows, in order from the left; the first ones are
    // dropped when short of room. Leave a name out to hide it, or write a bare
    // `segments` to show none. The bell always stays at the right edge.
    //   antigravity, claude, zai  each AI provider's quota, under its logo
    //   tool                      where the focused editor's keys stand (12:5, 340 lines),
    //                             then its icon
    // Default: all, in the order below, with each extension's segment before
    // "tool".
    // segments "antigravity" "claude" "zai" "tool"
}

notifications {
    // Show warnings and errors as cards stacked in the window's top-right
    // corner; confirmations are said in the status bar. With #false every
    // notice is said in the status bar. While the bar is hidden, every notice
    // is a card. All are kept: the bell at the status bar's right edge opens
    // the history.
    // Default: shown (#true).
    toasts #true
}

// The comment keywords the Todo list ("Todo: List Keywords in Project" in the
// palette) finds across the project, each as a whole word in its own case:
// "TODO" finds `// TODO:` and `TODO(me)`, never `todos`.
// Default: "TODO" "FIXME" "XXX" "HACK" "BUG".
todo-keywords "TODO" "FIXME" "XXX" "HACK" "BUG"

// How the text editor completes what is typed: C-SPC opens the popup while
// typing, C-n / C-p (or Down / Up) move through it, Tab takes the entry, and
// RET does too once the popup was asked for or moved through; Escape closes it.
completion {
    // Open the popup by itself once a word typed is min-chars long, and
    // straight after a `\`, `/`, `{`, or `#`, rather than only on C-SPC.
    // Default: on (#true).
    auto #true
    // How long typing pauses, in milliseconds, before the popup opens by
    // itself, so it does not flicker up under every word typed straight
    // through. C-SPC opens it at once whatever this is, and an open popup
    // narrows at once as typing goes on. 0 opens it on the key.
    // Default: 300.
    delay-ms 300
    // Default: 3.
    min-chars 3
    // The back-ends each language asks, in order: the first with anything to
    // offer decides where the completed text starts, and the later ones
    // answering there are merged in under it. A language not named here asks
    // its defaults: latex "latex" "lsp" "snippets" "paths" "words", markdown
    // "markdown" "lsp" "snippets" "paths" "words", and every other one "lsp"
    // "snippets" "keywords" "paths" "words". The back-ends are words (the open buffers),
    // paths (files, after a `/`), snippets (each language's own and the files
    // in snippets/<language>/ beside this one), keywords, latex (commands,
    // environments, \ref labels, \cite keys), markdown (link targets and
    // heading anchors), and lsp (a language server, once one is started).
    // backends {
    //     rust "snippets" "keywords" "words"
    // }
}

// GitHub Copilot's suggestions in the text editor, through
// copilot-language-server and the Copilot sign-in on this machine (Copilot:
// Sign In makes one). Started the first time a file is typed into. While a
// suggestion shows, Tab takes it, M-f (or C-,) a word of it, C-. a line of
// it, M-n / M-p the next or previous, and C-g hides it; C-\ asks for one.
copilot {
    // Default: on (#true).
    enable #true
    // Ghost text at the cursor as you type. Default: on (#true).
    completions #true
    // The edit Copilot expects next after a change, in a card for Tab to
    // make. Default: on (#true).
    next-edit #true
    // The server to run. Empty looks on the PATH, then in Winter's own
    // cache, then in magic-vscode's. Default: "".
    server-path ""
}

// Language servers. None starts by itself: LSP: Start (palette) starts the
// one for the file in front, and every open file of its project is handed
// to it. Winter knows rust-analyzer, pyright (or basedpyright, pylsp, ruff),
// gopls, clangd, typescript-language-server, texlab, marksman,
// bash-language-server, ocamllsp, taplo, yaml-language-server,
// vscode-json-language-server, lua-language-server, haskell-language-server,
// zls, and nil, the first of a language's installed being the one used.
lsp {
    // The languages whose server starts as soon as a file of theirs is open.
    // Default: none.
    // auto-start "rust" "python"
    // The program, with its arguments, that serves a language, in place of
    // the one Winter knows, or for a language it does not.
    // servers {
    //     python "pylsp"
    //     c "clangd" "--background-index"
    // }
}

compile {
    // Show the Compile tab in the dock panel along the bottom of the window.
    // Default: on (#true).
    dock #true
    // When a build fails, open its first error in the file you are in,
    // without having to press F8 (Emacs' compilation-auto-jump-to-first-error).
    // Default: on (#true).
    jump-to-error #true
    // The command a LaTeX document is built with in the Compile tab (the
    // palette's "LaTeX: Compile Document", or C-S-b from a .tex file). The
    // root file's name is added after it, the root being the file a
    // `% !TEX root = ...` comment names or the one declaring \documentclass.
    // Keep -file-line-error, which is how errors are placed in their files.
    // Default: "latexmk -pdf -interaction=nonstopmode -file-line-error -synctex=1".
    latex-command "latexmk -pdf -interaction=nonstopmode -file-line-error -synctex=1"
    // Rebuild a document whenever one of its .tex files is saved in Winter,
    // in its Compile tab, without taking the focus from the file.
    // Default: off (#false).
    latex-on-save #false
}

// Which line-editor bindings your shell answers to, for Vim operators on the
// prompt line (d/c/r/~ and prompt undo/redo in Normal mode). Winter sends the
// shell the equivalent keystrokes, so it has to know which set to send; it
// cannot detect this, because no shell reports its editing mode.
//   "emacs" the readline/ZLE default: C-a, C-k, C-u, C-w, M-d
//   "none"  do not translate. Use this if your shell is in vi mode
//           (bindkey -v, set editing-mode vi, fish vi bindings): those chords
//           mean something else there, and the shell gives you Vim editing on
//           the prompt line anyway.
prompt-edit-bindings "emacs"

// ── Security ──────────────────────────────────────────────────────────────────
// Let programs read the clipboard through OSC 52 (`ESC ] 52 ; c ; ?`). Off by
// default because the query is silent and unconditional on the querying side:
// any program in the pane, including one behind `ssh`, could pull what you last
// copied. Replies are capped at 64 KiB of text.
clipboard-read #false

// ── Color overrides ───────────────────────────────────────────────────────────
// Override individual colors from the active theme preset.
// All keys are optional; remove the block entirely to use unmodified preset colors.
//
// Values shown are the "dark" preset defaults, which are magic-vscode's One Color theme.
//
// colors {
//     background       "#262a32"
//     foreground       "#bbc2cf"
//     cursor-bg        "#51afef"
//     cursor-fg        "#000000"
//     selection-bg     "#2257a0"
//     selection-fg     "#ffffff"
//     split            "#51554f"   // pane separator line color (see also pane-border-width)
//     status-bar-border "#3a3f45"  // 1px line above the status bar
//     visual-bell      "#e08020"   // tab-bar flash color on bell (uses built-in default when unset)
//     active-indicator "#1a75e8"   // the active tab's top bar
//     tab-strip        "#21242a"   // the band a pane's tabs sit on (shaded from the background when unset)
//     line-number-active "#787e88" // the cursor's line number (drawn like the others when unset)
//     active-pane-border "#7d8590" // thin line under the focused pane when several are shown
//
//     // The git views, defaulting (on the dark preset) to magic-vscode's palette. Any name
//     // can be omitted; one the theme sets none for is derived from its ANSI colors.
//     git {
//         modified "#8fb1f5"
//         added "#91af22"
//         deleted "#da5f59"
//         renamed "#d1b32f"
//         unmerged "#a75abe"
//         header-staged "#1bb1b1"
//         header-unstaged "#da8548"
//         header-untracked "#63b417"
//         header "#51afef"
//         ref-head "#cf81f5"
//         ref-local "#cf81f5"
//         ref-remote "#6e8b3d"
//         ref-tag "#2d9574"
//         unpushed "#7bdd0b"
//         file-staged "#1bb1b1"
//         file-unstaged "#da8548"
//         file-untracked "#63b417"
//         file-conflict "#f14c4c"
//         file-band "#14708acc"
//         hunk-band "#1f3e4e"
//         inserted-line "#23372dfb"
//         inserted-text "#215714df"
//         removed-line "#512b3299"
//         removed-text "#8f3f3fdf"
//     }
//
//     // Any color may end in an alpha byte ("#rrggbbaa"). A color is blended over the
//     // background once, when the config loads. The background's own alpha makes the
//     // window see-through (multiplied with the top-level `opacity`); the tab bar,
//     // menus and status bar stay solid.
//
//     // Source in the built-in text editor, defaulting (on the dark preset) to magic-vscode's
//     // palette. Any name can be omitted; one the theme sets none for uses its ANSI colors.
//     syntax {
//         comment "#718b9f"
//         keyword "#51afef"
//         number "#da8548"
//         string "#2d9574"
//         type "#cf517a"
//     }
//
//     // 8 normal ANSI colors, by name. Any name can be omitted.
//     ansi {
//         black "#1b2229"
//         red "#c22727"
//         green "#71b312"
//         yellow "#faa213"
//         blue "#4fa2fa"
//         magenta "#bb67b2"
//         cyan "#21afbf"
//         white "#bbc2cf"
//     }
//
//     // 8 bright ANSI colors, same names as above.
//     brights {
//         black "#7a7a7a"
//         red "#d43f30"
//         green "#71b312"
//         yellow "#ebb909"
//         blue "#5da2eb"
//         magenta "#c97df5"
//         cyan "#04cfe1"
//         white "#e1ebfa"
//     }
//
//     // Override a single 256-color palette entry (index 0-255).
//     indexed {
//         "136" "#af8700"
//     }
// }
